{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "PumpOS",
  "version": "1.0.0",
  "identifier": "com.pumpos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PumpOS",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' https: ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/abdullahnettoor/pumpos/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1RkE1NThEMjVGOUMwNEQKUldSTndQa2xqVlg2SlhaRldUWFpNRFdGZFlzMEVzZ00xRGdiSnozTFJsTk0vSERDaHE0OGcrTTMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
