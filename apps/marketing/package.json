{
  "name": "apps-marketing",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "SITE=https://pumpos.app PUBLIC_CONSOLE_URL=https://console.pumpos.app astro build && wrangler deploy",
    "deploy:dev": "SITE=https://pumpos.abdullahnettoor.com PUBLIC_CONSOLE_URL=https://console.pumpos.abdullahnettoor.com astro build && wrangler deploy --env preview",
    "lint": "eslint . --pass-on-unpruned-suppressions",
    "lint:fix": "npm run lint -- --fix",
    "lint:baseline": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@tailwindcss/postcss": "^4.3.3",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro-eslint-parser": "^3.1.0",
    "astro-pagefind": "^2.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.0"
  }
