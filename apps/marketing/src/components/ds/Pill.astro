---
interface Props {
  tone?: 'default' | 'mint' | 'primary' | 'amber' | 'danger';
  class?: string;
  [key: string]: unknown;
}

const {
  tone = 'default',
  class: className = '',
  ...rest
} = Astro.props;

const classes = [
  'ds-pill',
  tone !== 'default' ? `ds-pill--${tone}` : '',
  className,
].filter(Boolean).join(' ');
---
<span class={classes} {...rest}>
  <slot />
</span>
