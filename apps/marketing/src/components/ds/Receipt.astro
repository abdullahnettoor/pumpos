---
interface LineItem {
  label: string;
  value: string;
}

interface Props {
  eyebrow?: string;
  amount?: string;
  status?: string;
  items?: LineItem[];
  class?: string;
  [key: string]: unknown;
}

const defaultItems: LineItem[] = [
  { label: 'From', value: 'Malabar Transports' },
  { label: 'Method', value: 'Bank transfer' },
  { label: 'Into', value: 'Station bank account' },
  { label: 'Drawer cash', value: 'Not touched' },
  { label: 'Due after', value: '₹27,500' },
];

const {
  eyebrow = 'Collection · 03 Oct · Entry date',
  amount = '₹15,000',
  status,
  items = defaultItems,
  class: className = '',
  ...rest
} = Astro.props;
---
<div class:list={['ds-card ds-rcpt', className]} role="region" aria-label={`Receipt preview: ${amount} from ${items[0]?.value ?? 'customer'}`} {...rest}>
  <div style="display: flex; justify-content: space-between; align-items: baseline;">
    <p class="ds-ey" style="margin: 0;">{eyebrow}</p>
    {status && <span class="ds-st">{status}</span>}
  </div>
  <strong>{amount}</strong>
  <dl class="ds-bd">
    {items.map((it) => (
      <div>
        <dt class="ds-mut">{it.label}</dt>
        <dd style="margin: 0; font-weight: 600;">{it.value}</dd>
      </div>
    ))}
  </dl>
</div>
