---
import SampleDataBadge from './SampleDataBadge.astro';

interface LineItem {
  label: string;
  value: string;
}

interface Props {
  eyebrow?: string;
  amount?: string;
  status?: string;
  items?: LineItem[];
  class?: string;
}

const defaultItems: LineItem[] = [
  { label: 'Customer', value: 'Malabar Transports' },
  { label: 'Mode', value: 'Bank transfer (NEFT)' },
  { label: 'Reference', value: 'UTR9823412' },
  { label: 'Balance after', value: '₹27,500' },
];

const {
  eyebrow = 'Collection receipt',
  amount = '₹15,000',
  status = 'Recorded',
  items = defaultItems,
  class: className = '',
} = Astro.props;
---
<div class:list={['h-card ds-rcpt h-rcpt', className]} role="region" aria-label={`${eyebrow} preview`}>
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <span class="ds-ey">{eyebrow}</span>
    <div style="display:flex; align-items:center; gap:8px;">
      {status && <span class="ds-st">{status}</span>}
      <SampleDataBadge />
    </div>
  </div>
  <strong>{amount}</strong>
  <div class="h-bd">
    {items.map((it) => (
      <div>
        <dt>{it.label}</dt>
        <dd>{it.value}</dd>
      </div>
    ))}
  </div>
</div>
