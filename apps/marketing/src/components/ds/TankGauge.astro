---
import SampleDataBadge from './SampleDataBadge.astro';

interface Props {
  fuel?: string;
  tank?: string;
  fillPercent?: number;
  expected?: string;
  actual?: string;
  variance?: string;
  reason?: string;
  class?: string;
}

const {
  fuel = 'HSD',
  tank = 'Tank 2',
  fillPercent = 72,
  expected = '14,220 L',
  actual = '14,202 L',
  variance = '−18 L',
  reason = 'temperature / evaporation',
  class: className = '',
} = Astro.props;
---
<div class:list={['ds-card ds-tank-gauge', className]} style="padding: 24px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <span class="ds-ey">{fuel} · {tank}</span>
    <SampleDataBadge />
  </div>
  <div class="ds-bp-tank">
    <div class="ds-tk" aria-hidden="true"><i style={`height: ${fillPercent}%;`}></i></div>
    <div>
      <div style="font-size: 13px; color: var(--ds-muted); margin-bottom: 4px;">Dip & reconciliation</div>
      <div style="font-size: 26px; font-weight: 800; letter-spacing: -.03em; color: var(--ds-amber-ink); font-variant-numeric: tabular-nums;">
        {variance}
      </div>
      <div style="font-size: 13px; color: var(--ds-muted); margin-top: 4px;">
        {actual} of {expected}
      </div>
      {reason && (
        <div style="font-size: 11px; color: var(--ds-muted); margin-top: 6px;">
          Flagged: {reason}
        </div>
      )}
    </div>
  </div>
</div>
