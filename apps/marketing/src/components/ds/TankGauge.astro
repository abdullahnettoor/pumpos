---
import SampleDataBadge from './SampleDataBadge.astro';

interface Props {
  fuel?: string;
  tank?: string;
  fillPercent?: number;
  expected?: string;
  actual?: string;
  variance?: string;
  reason?: string;
  class?: string;
}

const {
  fuel = 'HSD',
  tank = 'Tank 2',
  fillPercent = 72,
  expected = '14,220 L',
  actual = '14,202 L',
  variance = '−18 L',
  reason = 'temperature / evaporation',
  class: className = '',
} = Astro.props;
---
<div class:list={['ds-card ds-tank-gauge', className]} style="padding: 24px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <span class="ds-ey">{fuel} · {tank}</span>
    <SampleDataBadge />
  </div>
  <div class="ds-bp-tank">
    <div class="ds-tk" aria-hidden="true">
      <i style={`height: ${fillPercent}%;`}></i>
    </div>
    <div style="display:flex; flex-direction:column; gap:6px;">
      <div style="font-size: 15px; font-weight: 700; color: var(--ds-ink);">
        Dip: {actual}
      </div>
      <div style="font-size: 13px; color: var(--ds-muted);">
        Expected book stock: {expected}
      </div>
      {variance && (
        <div style="font-size: 13px; font-weight: 700; color: var(--ds-amber-ink); background: var(--ds-amber-soft); padding: 4px 8px; border-radius: 6px; display: inline-block; width: fit-content;">
          Variance: {variance} {reason ? `· ${reason}` : ''}
        </div>
      )}
    </div>
  </div>
</div>
