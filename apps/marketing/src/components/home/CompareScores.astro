---
import Section from '../ds/Section.astro';
import SectionHeading from '../ds/SectionHeading.astro';
import Card from '../ds/Card.astro';
import { compareRows } from '../../data/home';
const cols = [
  { name: 'Registers & Excel', col: 1, mark: '✗', label: 'No', cls: '' },
  { name: 'Typical pump software', col: 2, mark: '~', label: 'Partly', cls: 'h-sc--mid' },
  { name: 'PumpOS', col: 3, mark: '✓', label: 'Yes', cls: 'h-sc--us' },
] as const;
---
<Section style="padding-top:0" aria-labelledby="compare-title">
  <SectionHeading eyebrow="Before you compare" title="Feature lists look alike. Ask these instead." id="compare-title" />
  <div class="h-score">
    {cols.map((c) => (
      <Card class:list={['h-sc', c.cls]}>
        <h3>{c.name}</h3>
        <ul>{compareRows.map((r) => <li><i aria-label={c.label}>{c.mark}</i><div><small>{r[0]}</small>{r[c.col]}</div></li>)}</ul>
      </Card>
    ))}
  </div>
  <p class="h-note">"Typical pump software" reflects common patterns we hear from dealers, not any one product.</p>
</Section>
