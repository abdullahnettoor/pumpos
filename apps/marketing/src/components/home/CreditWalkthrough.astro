---
import ProgressTabs from './ProgressTabs.astro';
import StatementTable from '../ds/StatementTable.astro';
import Receipt from '../ds/Receipt.astro';
import PhoneFrame from '../ds/PhoneFrame.astro';
import { creditSteps, statement } from '../../data/home';
const views = [
  { panel: 0, outstanding: '₹42,500', rows: statement.slice(0, 2), foot: 'The customer owes ₹42,500 before this collection. Sample data.' },
  { panel: 2, outstanding: '₹27,500', rows: statement, foot: '₹42,500 − ₹15,000 = ₹27,500 outstanding. Sample data.' },
];
---
<ProgressTabs id="credit" eyebrow="A closer look at customer credit" title="“Has that customer paid us yet?”" items={creditSteps}>
  {views.slice(0, 1).map((v) => (
    <StatementTable
      data-panel={v.panel}
      customer="Malabar Transports"
      category="Fleet · Credit limit ₹75,000"
      outstanding={v.outstanding}
      entries={v.rows.map((r) => ({ date: r[0], desc: r[1], amount: r[2], bal: r[3] }))}
      note={v.foot}
    />
  ))}
  <Receipt
    data-panel="1"
    eyebrow="Collection · 03 Oct · Entry date"
    amount="₹15,000"
    items={[
      { label: 'From', value: 'Malabar Transports' },
      { label: 'Method', value: 'Bank transfer' },
      { label: 'Into', value: 'Station bank account' },
      { label: 'Drawer cash', value: 'Not touched' },
      { label: 'Due after', value: '₹27,500' },
    ]}
  />
  {views.slice(1).map((v) => (
    <StatementTable
      data-panel={v.panel}
      customer="Malabar Transports"
      category="Fleet · Credit limit ₹75,000"
      outstanding={v.outstanding}
      entries={v.rows.map((r, i) => ({ date: r[0], desc: r[1], amount: r[2], bal: r[3], isCredit: i === v.rows.length - 1 }))}
      note={v.foot}
    />
  ))}
  <PhoneFrame data-panel="3">
    <small class="h-mut">Owner view · Sample</small>
    <b>Malabar Transports</b>
    <div class="h-r"><span>Outstanding</span><b>₹27,500</b></div>
    <div class="h-r"><span>Last collection</span><b>₹15,000</b></div>
    <div class="h-r"><span>Limit used</span><b>37%</b></div>
  </PhoneFrame>
</ProgressTabs>
