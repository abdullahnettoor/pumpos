---
import { dayline } from '../../data/home';
---
<section class="h-sec h-dark" aria-labelledby="roles-title">
  <div class="h-w">
    <p class="h-ey">Who uses it</p>
    <h2 class="h-h2" id="roles-title">One record. Each person sees their part of it.</h2>
    <p class="h-lead">Roles decide who can do what. Nobody edits a closed day, and every change is logged with a name.</p>
    <ol class="h-dayline">{dayline.map(([time, role, title, body]) => <li><time>{time}</time><small>{role}</small><h3>{title}</h3><p>{body}</p></li>)}</ol>
  </div>
</section>
