---
import ProgressTabs from './ProgressTabs.astro';
import { screens, khata, dsrRows } from '../../data/home';
const status = { 'In limit': '', 'Near limit': 'h-st--near', Overdue: 'h-st--over' } as const;
---
<ProgressTabs id="inside" eyebrow="Inside PumpOS" title="The screens your team works in every day." items={screens}>
  <div data-panel="0" class="h-card">
    <div class="h-kt" role="table" aria-label="Sample customer dues">
      <div role="row"><span>Customer</span><span>Type</span><span>Due</span><span>Status</span></div>
      {khata.map(([name, type, due, st]) => <div role="row"><b>{name}</b><span class="h-mut">{type}</span><span>{due}</span><span class:list={['h-st', status[st]]}>{st}</span></div>)}
    </div>
  </div>
  <div data-panel="1" class="h-card h-phone-wrap">
    <div class="h-phone"><small class="h-mut">DU-2 · Evening shift · Sample</small><b>Hand over drawer</b>{[['Cash', '₹78,600'], ['UPI', '₹31,250'], ['Card', '₹11,250']].map(([a, b]) => <div class="h-r"><span>{a}</span><b>{b}</b></div>)}<div class="h-go">Submit handover</div></div>
  </div>
  <div data-panel="2" class="h-card h-dsr">
    <div class="h-dsr-h"><div><b>Day closing · DSR</b><small>Abne Fuels · 04 Oct 2026</small></div><span class="h-pill">Sample data</span></div>
    <div class="h-dsr-rows">{dsrRows.map(([a, b]) => <div><span class="h-mut">{a}</span><b>{b}</b></div>)}<div><span>Cash expected</span><b>₹2,14,250</b></div></div>
  </div>
</ProgressTabs>
