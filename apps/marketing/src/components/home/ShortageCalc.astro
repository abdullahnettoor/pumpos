---
import Section from '../ds/Section.astro';
import Card from '../ds/Card.astro';
// Plain arithmetic on the visitor's own number: daily shortage × 365. No claims about
// what PumpOS saves; it only shows what an unnoticed daily gap adds up to.
const start = 350;
const inr = (n: number) => '₹' + Math.round(n).toLocaleString('en-IN');
---
<Section class="h-calc-wrap" aria-labelledby="calc-title" data-calc>
  <Card class="h-calc">
    <div>
      <p class="ds-ey">Small gaps add up</p>
      <h2 id="calc-title">If a drawer comes back short by <output data-daily>{inr(start)}</output> a day…</h2>
      <label class="h-calc-range"><span class="sr-only">Daily shortage in rupees</span><input type="range" min="50" max="2000" step="50" value={start} data-input aria-valuetext={`${inr(start)} a day`} /></label>
      <div class="h-calc-scale" aria-hidden="true"><span>₹50</span><span>₹2,000 a day</span></div>
    </div>
    <dl>
      <div><dt data-year>{inr(start * 365)}</dt><dd>lost in a year</dd></div>
      <div><dt data-month>{inr(start * 30)}</dt><dd>in a month</dd></div>
      <div><dt>₹15,990</dt><dd>PumpOS Pro for a whole year</dd></div>
    </dl>
  </Card>
</Section>

<script>
  const inr = (n: number) => '₹' + Math.round(n).toLocaleString('en-IN');
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const set = () => {
      const v = Number(input.value);
      root.querySelector('[data-daily]')!.textContent = inr(v);
      root.querySelector('[data-year]')!.textContent = inr(v * 365);
      root.querySelector('[data-month]')!.textContent = inr(v * 30);
      input.setAttribute('aria-valuetext', `${inr(v)} a day`);
      input.style.setProperty('--fill', `${((v - 50) / 1950) * 100}%`);
    };
    input.addEventListener('input', set);
    set();
  });
</script>
