---
interface Props {
  direction: 'ledger' | 'continuity' | 'stamp';
}
const { direction } = Astro.props;
---

<figure class={`statement statement--${direction}`}>
  <figcaption class="statement-caption">
    <span>Customer statement</span>
    <span class="sample-label">Sample data</span>
  </figcaption>
  <div class="statement-customer">
    <div class="customer-avatar" aria-hidden="true">MT</div>
    <div><h3>Malabar Transport</h3><p>Credit customer · Sample station</p></div>
    <svg class="statement-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
  </div>
  <dl class="statement-entries">
    <div class="statement-entry"><dt><span class="entry-symbol" aria-hidden="true">+</span>Amount due</dt><dd>₹42,500<span>Before collection</span></dd></div>
    <div class="statement-entry collection-entry"><dt><span class="entry-symbol" aria-hidden="true">−</span>Collection recorded</dt><dd>₹15,000<span>Bank transfer</span></dd></div>
    <div class="statement-entry remaining-entry"><dt>Outstanding</dt><dd>₹27,500<span>After collection</span></dd></div>
  </dl>
  <div class="statement-footnote"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 3h10v14H5zM8 7h4m-4 3h4m-4 3h2" stroke="currentColor" stroke-width="1.4" /></svg>Every entry, there to inspect.</div>
</figure>
