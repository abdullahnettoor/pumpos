      <div class="pf-grid"><div class="pf-field"><span>N1 · Petrol</span><b>528912.40</b><small>Opening 528438.20 · 474.20 L</small></div><div class="pf-field"><span>Testing (L)</span><b>5</b></div></div>
      <div class="pf-grid"><div class="pf-field"><span>N2 · Diesel</span><b>412904.10</b><small>Opening 412876.00 · 28.10 L</small></div><div class="pf-field"><span>Testing (L)</span><b>0</b></div></div>
