---
// Inlined by the bundler at build time, not read at runtime: Astro compiles this
// component into `dist/.prerender/chunks/`, where any module-relative path to
// `public/` would no longer resolve. `?raw` embeds the artwork's bytes instead,
// so the mark cannot go missing after the build.
import markSvg from '../../../public/brand/pumpos-mark.svg?raw';
import { parseBrandMark } from '../../brand-mark.mjs';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { viewBox, path } = parseBrandMark(markSvg, 'public/brand/pumpos-mark.svg');
---

<!-- `currentColor` is load-bearing, not tidiness: the site header inverts onto a
     brand-green band where the mark has to go white, and the same mark sits in
     brand green in the footer and on blog cards. One fill serves both because
     the nozzle is knocked out rather than painted. -->
<svg class={className} viewBox={viewBox} fill="currentColor" aria-hidden="true">
  <path fill-rule="evenodd" clip-rule="evenodd" d={path} />
</svg>
