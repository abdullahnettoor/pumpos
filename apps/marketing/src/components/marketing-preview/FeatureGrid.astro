---
import { features } from '../../data/home-features';
---
<section class="feature-grid site-container" id="features">
  <div class="feature-intro"><p class="section-context">Everything in one place</p><h2>The whole station,<br />not just the shift.</h2></div>
  <ul>{features.map((f) => <li class={f.comingSoon ? 'is-soon' : undefined}>
    {f.comingSoon && <span class="soon-badge">Coming soon</span>}
    <h3>{f.href && !f.comingSoon ? <a href={f.href}>{f.title} <span aria-hidden="true">↗</span></a> : f.title}</h3>
    <p>{f.body}</p>
  </li>)}</ul>
  <p class="feature-note">Planned items are separate from the pilot offer and will be shaped by what pilot stations need.</p>
</section>
