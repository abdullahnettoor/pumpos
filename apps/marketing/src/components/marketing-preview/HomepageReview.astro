---
import BrandMark from './BrandMark.astro';
import CollectionWalkthrough from './CollectionWalkthrough.astro';
import previewStyles from '../../styles/site.css?url';
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>PumpOS · Your station. Your numbers.</title>
    <link rel="stylesheet" href={previewStyles} />
    <meta name="description" content="Check customer dues, recorded collections and shift reports yourself. Explore the PumpOS guided pilot for Indian fuel stations." />
    <link rel="icon" href="/brand/pumpos-mark.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/brand/barlow-semi-condensed-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/brand/public-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="checkpoint-banner"><span>Design preview · Opening + collection walkthrough</span><a href="/design-review/identity#concept-stamp">View identity study ↗</a></div>
    <main id="main">
    <div class="opening">
      <header class="marketing-header"><a class="brand-wordmark" href="#main" aria-label="PumpOS home"><BrandMark /><span>Pump<span class="brand-os">OS</span></span></a><nav aria-label="Main navigation"><a href="#walkthrough">Explore the product</a><a href="#pilot">The guided pilot</a></nav><a class="header-demo" href="#pilot">Book a demo <span aria-hidden="true">↗</span></a></header>
        <section class="marketing-hero" aria-labelledby="hero-title">
          <div class="hero-message"><p class="hero-context">Fuel station management. Built for the owner, too.</p><h1 id="hero-title"><span>Your station.</span><span>Your numbers.</span><span class="hero-emphasis">No waiting.</span></h1><p class="hero-description">See customer dues, collections and shift reports yourself. Without waiting for someone to send an update.</p><div class="opening-actions"><a class="button-light" href="#pilot">Book a guided demo <span aria-hidden="true">↗</span></a><a class="text-link" href="#walkthrough">See how it works <span aria-hidden="true">↓</span></a></div><p class="opening-note">Introducing the PumpOS guided pilot.</p></div>
          <div class="hero-record"><div class="owner-question"><span>A question from the owner</span><p>“How much does<br />Malabar Transport owe us?”</p></div><div class="hero-statement"><div class="hero-statement-heading"><span>Customer statement</span><span>Sample data</span></div><div class="hero-customer"><span class="customer-initials" aria-hidden="true">MT</span><div><h2>Malabar Transport</h2><p>Credit customer</p></div></div><dl class="hero-entries"><div><dt>Amount due</dt><dd>₹42,500<span>Before collection</span></dd></div><div class="hero-collection" data-hero-collection><dt><span aria-hidden="true">↙</span> Collection recorded</dt><dd>₹15,000<span>Bank transfer</span></dd></div><div class="hero-balance"><dt>Still outstanding</dt><dd>₹27,500<span>After collection</span></dd></div></dl><a class="record-link" href="#walkthrough">Follow the entry <span aria-hidden="true">→</span></a></div><p class="record-disclaimer">An illustrative statement. Every figure has a place.</p></div>
        </section>
        <div class="opening-footer"><span>The operating system for fuel retail.</span><p>Shifts <span>/</span> Stock <span>/</span> Credit <span>/</span> Financials</p></div>
    </div>
    <div class="content-wrap"><CollectionWalkthrough /></div>
    <section id="pilot" class="pilot-preview" aria-labelledby="pilot-title"><div><p class="section-context">The PumpOS guided pilot</p><h2 id="pilot-title">Let's look at<br />your station.</h2></div><div class="pilot-description"><p>Walk through customer credit, collections and Shift close with us. We'll discuss your setup, onboarding and pricing during the demo.</p><a class="button-green" href="mailto:hello@pumpos.app?subject=PumpOS%20guided%20pilot">Email about the pilot <span aria-hidden="true">↗</span></a><p class="booking-note">Preview contact option. Calendar booking will be available once the demo schedule is configured.</p></div></section>
    </main>
    <footer class="marketing-footer"><a class="brand-wordmark" href="#main" aria-label="PumpOS home"><BrandMark /><span>Pump<span class="brand-os">OS</span></span></a><p>Creative checkpoint 2<br />Homepage opening and one complete product scene.</p><a href="#walkthrough">Back to the walkthrough ↑</a></footer>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const collection = document.querySelector<HTMLElement>('[data-hero-collection]');
      if (collection && !reduceMotion.matches && !document.hidden && typeof collection.animate === 'function') {
        const entrance = collection.animate([
          { transform: 'translateX(12px)', backgroundColor: '#d5e8dd' },
          { transform: 'translateX(0)', backgroundColor: '#ffffff' },
        ], { duration: 950, delay: 250, easing: 'cubic-bezier(.16,1,.3,1)' });
        reduceMotion.addEventListener('change', () => entrance.cancel(), { once: true });
      }
    </script>
  </body>
</html>
