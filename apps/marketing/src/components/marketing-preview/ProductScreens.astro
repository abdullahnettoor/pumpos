---
import { Image } from 'astro:assets';
import dayClose from '../../assets/screenshots/day-close.webp';
import drawerHandover from '../../assets/screenshots/drawer-handover.webp';
import dssr from '../../assets/screenshots/dssr.webp';

const screens = [
  { src: dayClose, title: 'Day closing', caption: 'Volume, revenue, dues and every shift\'s cash difference on one screen.', alt: 'PumpOS day closing screen for Hilltop Fuels Kozhikode: 1,564.6 L sold, revenue ₹1,61,498.63, credit issued ₹9,000 and a cash variance of ₹0.00.' },
  { src: drawerHandover, title: 'DSM handover', caption: 'Each attendant\'s readings, card/UPI and cash are checked before the shift closes.', alt: 'PumpOS attendant handover for Ramesh PV on DU-2: nozzle closing readings, HDFC POS card ₹22,000 and UPI ₹15,200, cash handed over ₹32,000.' },
  { src: dssr, title: 'Daily sales report', caption: 'Frozen once the day closes, ready to print or save as PDF.', alt: 'PumpOS Daily Sales Summary Record for 22 Sept 2026: fuel sales ₹1,60,458.63, collections ₹5,000 and a profit and loss summary.' },
];
---
<section class="product-screens site-container" id="screens">
  <div class="product-screens-intro">
    <p class="section-context">Inside PumpOS</p>
    <h2>The real screens,<br /><span>from a working station.</span></h2>
  </div>
  <div class="product-screens-grid">
    {screens.map((s, i) => (
      <figure class={i === 0 ? 'is-lead' : undefined}>
        <Image src={s.src} alt={s.alt} widths={[640, 1000, 1400]} sizes={i === 0 ? '(max-width: 900px) 100vw, 1100px' : '(max-width: 900px) 100vw, 540px'} loading="lazy" />
        <figcaption><strong>{s.title}</strong> {s.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>
