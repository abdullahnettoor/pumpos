---
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import '../styles/site.css';
interface Props { title: string; description?: string; path?: string; green?: boolean; noindex?: boolean; article?: boolean; }
const { title, description = 'Fuel station management for Indian owners. Inspect customer dues, collections, stock and Shift reports with PumpOS.', path = '/', green = false, noindex = false, article = false } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const ogImage = new URL('/og-default.png', Astro.site).toString();
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#1f6a53" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/brand/pumpos-mark.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/brand/public-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/brand/barlow-semi-condensed-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="PumpOS. Your station. Your numbers. No waiting." /><meta property="og:site_name" content="PumpOS" /><meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="PumpOS Journal" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader path={path} tone={green ? 'dark' : 'light'} />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script>
      import { initialiseSiteMotion } from '../scripts/site-motion';
      initialiseSiteMotion();
    </script>
  </body>
</html>
