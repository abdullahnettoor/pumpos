---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import Search from 'astro-pagefind/components/Search.astro';
interface Props { title:string; description?:string; currentId:string }
const {title,description,currentId}=Astro.props;
const docs=(await getCollection('docs')).sort((a,b)=>a.data.order-b.data.order||a.data.title.localeCompare(b.data.title));
const groups=[...new Set(docs.map(d=>d.data.category??'Guides'))].map(category=>({category,items:docs.filter(d=>(d.data.category??'Guides')===category)}));
---
<BaseLayout title={`${title} | PumpOS Docs`} description={description} path={`/docs/${currentId}`}>
 <div class="docs-shell site-container"><aside class="docs-sidebar"><Search id="docs-search" className="docs-search" uiOptions={{showImages:false}} /><nav aria-label="Documentation">{groups.map(g=><div><h2>{g.category}</h2><ul>{g.items.map(item=><li><a href={`/docs/${item.id}`} aria-current={item.id===currentId?'page':undefined}>{item.data.title}</a></li>)}</ul></div>)}</nav><details class="docs-mobile"><summary>Browse the guides</summary><nav aria-label="Mobile documentation">{docs.map(item=><a href={`/docs/${item.id}`} aria-current={item.id===currentId?'page':undefined}>{item.data.title}</a>)}</nav></details></aside><article class="docs-content" data-pagefind-body><h1>{title}</h1>{description&&<p>{description}</p>}<div class="prose-pump"><slot /></div><div class="article-next">Need help setting up your station? <a href="/demo">Talk to us.</a></div></article></div>
</BaseLayout>
