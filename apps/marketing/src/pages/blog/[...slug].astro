---
import ProseLayout from '../../layouts/ProseLayout.astro';
import Button from '../../components/ds/Button.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/content-pages.css';

export async function getStaticPaths() {
  return (await getCollection('blog', ({ data }) => !data.draft)).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (date: Date) =>
  date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<ProseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}`}
  eyebrow="Journal"
  backHref="/blog"
  backLabel="Journal"
  article
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
    {post.data.updatedAt && <meta property="article:modified_time" content={post.data.updatedAt.toISOString()} />}
  </Fragment>
  <div slot="meta" class="prose-meta">
    <time datetime={post.data.publishedAt.toISOString()}>{fmt(post.data.publishedAt)}</time>
    {post.data.updatedAt && <span>Updated {fmt(post.data.updatedAt)}</span>}
    <div class="prose-tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
  </div>
  <Content />
  <div slot="after" class="prose-after">
    <span>See the record for yourself.</span>
    <Button href="/product" variant="secondary">Explore PumpOS <span aria-hidden="true">→</span></Button>
  </div>
</ProseLayout>
