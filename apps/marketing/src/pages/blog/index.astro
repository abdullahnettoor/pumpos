---
// PROTOTYPE (branch prototype/journal-variants): in dev, /blog?variant=A|B|C|D switches the list layout.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ds/Section.astro';
import Card from '../../components/ds/Card.astro';
import VariantA from '../../components/journal-prototype/VariantA.astro';
import VariantB from '../../components/journal-prototype/VariantB.astro';
import VariantC from '../../components/journal-prototype/VariantC.astro';
import VariantD from '../../components/journal-prototype/VariantD.astro';
import Switcher from '../../components/journal-prototype/Switcher.astro';
import { getLivePosts } from '../../blog';
import '../../styles/content-pages.css';

const posts = await getLivePosts();
const prototype = import.meta.env.DEV;
const variants = [
  { key: 'A', name: 'Cards (PR #678)' },
  { key: 'B', name: 'Editorial index' },
  { key: 'C', name: 'Text index' },
  { key: 'D', name: 'Magazine split' },
];
---
<BaseLayout title="Journal | Notes on building PumpOS" description="Product notes and practical explanations of fuel station operations from PumpOS." path="/blog">
  <Section class="journal-section" aria-label="The PumpOS journal">
    <div class="ds-w">
      <header class="journal-intro">
        <p class="ds-ey">The PumpOS journal</p>
        <h1 class="ds-h1">Notes from the build.</h1>
        <p class="ds-lead">What we're building, why it works this way, and the station workflows behind it.</p>
      </header>
      {posts.length === 0 ? (
        <Card class="journal-empty">Our first product notes will appear here.</Card>
      ) : prototype ? (
        <>
          <div data-variant="A"><VariantA posts={posts} /></div>
          <div data-variant="B" hidden><VariantB posts={posts} /></div>
          <div data-variant="C" hidden><VariantC posts={posts} /></div>
          <div data-variant="D" hidden><VariantD posts={posts} /></div>
          <Switcher variants={variants} />
        </>
      ) : (
        <VariantA posts={posts} />
      )}
    </div>
  </Section>
</BaseLayout>
