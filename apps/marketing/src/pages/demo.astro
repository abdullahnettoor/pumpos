---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEMO_BOOKING_URL } from '../config';
---
<BaseLayout title="Book a guided demo | PumpOS" description="Walk through your station's credit, collections and Shift close. Discuss the PumpOS pilot, onboarding and pricing with us." path="/demo">
 <section class="page-heading site-container"><p class="section-context">Let's talk about your station</p><h1>Bring the questions.<br />We'll open the record.</h1><p>A guided look at PumpOS, with room to discuss how your station works today.</p></section>
 <div class="demo-layout site-container"><ol class="demo-agenda"><li><span>1</span><div><h2>Start with your current workflow.</h2><p>Tell us how you track Shifts, customer credit and daily reporting. Registers, spreadsheets or existing software are all useful starting points.</p></div></li><li><span>2</span><div><h2>Follow the work in PumpOS.</h2><p>We'll look at customer dues, recorded collections and Shift reconciliation, including the owner's view.</p></div></li><li><span>3</span><div><h2>Discuss a practical pilot.</h2><p>Review setup, connectivity, onboarding and the price for your station before deciding on next steps.</p></div></li></ol><aside class="booking-panel"><h2>{DEMO_BOOKING_URL ? 'Choose a time to talk.' : 'Arrange your guided demo.'}</h2><p>{DEMO_BOOKING_URL ? 'Select a time on our booking page. A short description of your station will help us prepare.' : 'Email us your name, station name and a convenient time to talk. We will arrange the demo with you.'}</p><a class="button-light" href={DEMO_BOOKING_URL ?? 'mailto:hello@pumpos.app?subject=PumpOS%20guided%20demo&body=Name%3A%0AStation%20name%3A%0APreferred%20time%20to%20talk%3A%0A'}>{DEMO_BOOKING_URL ? 'Choose a demo time' : 'Email to arrange a demo'} <span aria-hidden="true">↗</span></a><p class="booking-help">No customer records or financial files needed. We use sample data for the walkthrough.</p><a href="/#walkthrough">Explore the product before we talk →</a></aside></div>
</BaseLayout>
