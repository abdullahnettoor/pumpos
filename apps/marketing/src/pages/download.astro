---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONSOLE_URL, DOWNLOAD_MANIFEST_URL } from '../config';
const platforms = [
 { key:'windows-x64', label:'Windows', sub:'Windows 10/11 · 64-bit', icon:'M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z' },
 { key:'macos-arm64', label:'macOS', sub:'Apple Silicon', icon:'M4 3h16v14H4zM8 21h8M12 17v4' },
 { key:'macos-x64', label:'macOS', sub:'Intel', icon:'M4 3h16v14H4zM8 21h8M12 17v4' },
 { key:'linux-x64-appimage', label:'Linux', sub:'AppImage · 64-bit', icon:'M3 4h18v16H3zM7 9l3 3-3 3m6 0h4' },
 { key:'linux-x64-deb', label:'Linux', sub:'.deb · Debian / Ubuntu', icon:'M3 4h18v16H3zM7 9l3 3-3 3m6 0h4' },
];
---
<BaseLayout title="Download PumpOS | Desktop & web" description="Get the PumpOS desktop app for your station or open the web console. Check installer availability for Windows, macOS and Linux." path="/download">
 <section class="page-heading site-container"><p class="section-context">Your station workspace</p><h1>Ready for the next Shift.</h1><p>Use the desktop app at your station, or open PumpOS in your browser. Pilot access is arranged during onboarding.</p></section>
 <div class="site-container" data-manifest-url={DOWNLOAD_MANIFEST_URL}><section class="download-browser"><div><h2>Already have access?</h2><p>Open your station in the web console.</p></div><a class="button-green" href={CONSOLE_URL}>Open the web console ↗</a></section><p class="download-status" role="status" data-download-status>Installer availability is checked when this page loads.</p><noscript><p class="download-status">Enable JavaScript to check current releases, or contact us for an installer.</p></noscript><div class="download-list">{platforms.map(p => <div class="download-row" data-platform={p.key}><svg class="os-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d={p.icon} /></svg><div><h2>{p.label}</h2><p>{p.sub}</p></div><span data-meta>Availability not checked</span><a data-download aria-disabled="true" aria-label={`${p.label} ${p.sub}: availability not checked`}>Not available yet</a></div>)}</div><p class="download-help">Setting up your first station? <a href="/demo">Start with a guided demo.</a></p></div>
</BaseLayout>
<script>
 type Artifact = { url?: unknown; size?: unknown };
 const root = document.querySelector<HTMLElement>('[data-manifest-url]');
 const status = document.querySelector<HTMLElement>('[data-download-status]');
 async function loadDownloads() {
   if (!root || !status) return;
   status.textContent = 'Checking available installers…';
   try {
     const response = await fetch(root.dataset.manifestUrl!, { cache: 'no-store', signal: AbortSignal.timeout(10000) });
     if (!response.ok) throw new Error('Manifest unavailable');
     const manifest = await response.json();
     if (!manifest || typeof manifest.artifacts !== 'object' || !manifest.artifacts) throw new Error('Invalid manifest');
     let available = 0;
     root.querySelectorAll<HTMLElement>('[data-platform]').forEach(row => {
       const artifact = manifest.artifacts[row.dataset.platform!] as Artifact | undefined;
       const link = row.querySelector<HTMLAnchorElement>('[data-download]')!;
       const meta = row.querySelector<HTMLElement>('[data-meta]')!;
       let url: URL | null = null;
       try { if (typeof artifact?.url === 'string') { const candidate = new URL(artifact.url, location.origin); if (candidate.protocol === 'https:' || (candidate.origin === location.origin && candidate.protocol === 'http:')) url = candidate; } } catch { /* Invalid release link remains unavailable. */ }
       if (!url) { meta.textContent = 'Installer not published'; link.textContent = 'Coming soon'; link.setAttribute('aria-label', `${row.querySelector('h2')?.textContent} ${row.querySelector('p')?.textContent}: coming soon`); return; }
       available++;
       link.href = url.href; link.removeAttribute('aria-disabled'); link.textContent = 'Download ↗';
       link.setAttribute('aria-label', `Download PumpOS for ${row.querySelector('h2')?.textContent} ${row.querySelector('p')?.textContent}`);
       meta.textContent = [typeof manifest.version === 'string' ? `v${manifest.version}` : '', typeof artifact?.size === 'number' && artifact.size > 0 ? `${(artifact.size / 1048576).toFixed(1)} MB` : ''].filter(Boolean).join(' · ');
     });
     status.textContent = available ? 'Choose the installer that matches your device.' : 'Public installers are not available yet. Contact us for pilot setup.';
   } catch { status.textContent = 'We could not check installer availability. Try again later or contact hello@pumpos.app.'; root.querySelectorAll('[data-meta]').forEach(el => { el.textContent = 'Availability could not be checked'; }); }
 }
 loadDownloads();
</script>
