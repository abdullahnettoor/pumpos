---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ds/Section.astro';
import Card from '../components/ds/Card.astro';
import Button from '../components/ds/Button.astro';
import { CONSOLE_URL } from '../config';
import '../styles/content-pages.css';
---
<BaseLayout
  title="Desktop app | PumpOS"
  description="The PumpOS desktop app is available inside your console once your station is set up."
  path="/download"
>
  <Section class="download-section" container={false}>
    <div class="ds-w">
      <header class="download-heading">
        <p class="ds-ey">Desktop app</p>
        <h1 class="ds-h1">Get it from your console.</h1>
        <p class="ds-lead">The PumpOS desktop app is for stations that are already set up. Once you have onboarded your station in the web console, the desktop download appears there, matched to your computer.</p>
      </header>
      <Card class="download-browser">
        <div>
          <h2>Already set up?</h2>
          <p>Sign in and open Organization → Desktop app.</p>
        </div>
        <Button href={CONSOLE_URL}>Open console <span aria-hidden="true">↗</span></Button>
      </Card>
      <p class="download-help">New to PumpOS? <a href="/demo">Book a demo</a> and we will set up your station with you.</p>
    </div>
  </Section>
</BaseLayout>
