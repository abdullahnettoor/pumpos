---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LeakStack from '../components/home/LeakStack.astro';
import CreditWalkthrough from '../components/home/CreditWalkthrough.astro';
import DayTimeline from '../components/home/DayTimeline.astro';
import FeatureBento from '../components/home/FeatureBento.astro';
import CompareScores from '../components/home/CompareScores.astro';
import Pricing from '../components/home/Pricing.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import OfferCta from '../components/home/OfferCta.astro';
import ShortageCalc from '../components/home/ShortageCalc.astro';
import MobileCtaBar from '../components/home/MobileCtaBar.astro';
import { faqs, plans } from '../data/home';
import '../styles/home.css';

// Structured data so search results can show the FAQ and the plan prices.
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const appLd = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'PumpOS', applicationCategory: 'BusinessApplication', operatingSystem: 'Windows, macOS, Linux, Web',
  description: 'Fuel station management for Indian pump owners: nozzle readings, attendant drawers, stock, credit and the day report.',
  offers: plans.filter((p) => p.price.monthly !== null).map((p) => ({ '@type': 'Offer', name: p.name, price: p.price.monthly, priceCurrency: 'INR', description: 'Per station per month, excluding GST' })),
};
---
<BaseLayout title="PumpOS | Find the shortage today, not next month" description="PumpOS reconciles nozzle readings, cash and dues at day closing. Fuel station management for Indian pump owners. Core is ₹0 for the first 3 months." green>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(faqLd)} /><script type="application/ld+json" set:html={JSON.stringify(appLd)} /></Fragment>
  <div class="home">
    <Hero />
    <LeakStack />
    <ShortageCalc />
    <CreditWalkthrough />
    <DayTimeline />
    <FeatureBento />
    <CompareScores />
    <Pricing />
    <HomeFaq />
    <OfferCta />
    <MobileCtaBar />
  </div>
</BaseLayout>
