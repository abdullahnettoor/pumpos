---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LeakStack from '../components/home/LeakStack.astro';
import CreditWalkthrough from '../components/home/CreditWalkthrough.astro';
import InsideScreens from '../components/home/InsideScreens.astro';
import DayTimeline from '../components/home/DayTimeline.astro';
import FeatureBento from '../components/home/FeatureBento.astro';
import CompareScores from '../components/home/CompareScores.astro';
import Pricing from '../components/home/Pricing.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import OfferCta from '../components/home/OfferCta.astro';
import '../styles/home.css';
---
<BaseLayout title="PumpOS | Find the shortage today, not next month" description="PumpOS reconciles nozzle readings, cash and dues at day closing. Fuel station management for Indian pump owners. Core is ₹0 for the first 3 months." green>
  <div class="home">
    <Hero />
    <LeakStack />
    <CreditWalkthrough />
    <InsideScreens />
    <DayTimeline />
    <FeatureBento />
    <CompareScores />
    <Pricing />
    <HomeFaq />
    <OfferCta />
  </div>
</BaseLayout>
