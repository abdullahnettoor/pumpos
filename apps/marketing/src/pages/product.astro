---
import '../styles/content-pages.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ds/Section.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import Card from '../components/ds/Card.astro';
import Button from '../components/ds/Button.astro';
import FeatureCta from '../components/features/FeatureCta.astro';
import { DEMO_PATH, WA_URL } from '../components/home/links';
import { WHATSAPP_DISPLAY } from '../config';

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  gauge: svg('<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>'),
  drop: svg('<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>'),
  users: svg('<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'),
  file: svg('<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/>'),
  arrow: svg('<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>'),
  desktop: svg('<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>'),
  phone: svg('<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><line x1="12" x2="12.01" y1="18" y2="18"/>'),
  shield: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'),
};

const featureList = [
  {
    icon: icons.gauge,
    title: 'Shifts & Drawers',
    eyebrow: 'Operations & Cash Control',
    href: '/features/shifts-and-drawers',
    description: 'Derived nozzle reading sales, individual attendant drawers per Dispenser Unit (DU), mid-shift cash drops, and immediate shortage accountability before shift sign-off.',
    bullets: ['Automatic meter carry-forward', 'One drawer per DU', 'Mid-shift safe cash drops', 'Immutable shift summary'],
  },
  {
    icon: icons.drop,
    title: 'Stock & Tank Dips',
    eyebrow: 'Fuel & Lube Inventory',
    href: '/features/stock-and-dips',
    description: 'Track physical dip rod measurements against calculated book stock. Reconcile inward tanker decanting, density checks at 15°C, and record mandatory reason codes for every variance.',
    bullets: ['Expected book stock calculation', 'Mandatory variance reasons', 'Tanker decanting inward log', 'Packaged lube inventory'],
  },
  {
    icon: icons.users,
    title: 'Credit & Khata',
    eyebrow: 'Receivables & Fleet Accounts',
    href: '/features/credit-and-khata',
    description: 'Manage fleet credit sales linked to vehicle registration numbers. Live customer balances, dispute-free itemized statements, and bank collections separated from forecourt cash.',
    bullets: ['Vehicle-wise credit sales', 'Running ledger balance', 'Bank & NEFT collections', 'Sanctioned credit limits'],
  },
  {
    icon: icons.file,
    title: 'Reports & DSR',
    eyebrow: 'Reporting & Compliance',
    href: '/features/reports-and-dsr',
    description: 'Generate immutable Daily Station Sales Reports (DSSR) upon day close. State VAT on petrol and diesel, GST on lubricants, and a live Daily Cash Book for office entries.',
    bullets: ['Immutable DSSR snapshot', 'State VAT vs GST tax split', 'Daily Cash Book for office', 'Print-ready PDF exports'],
  },
];
---
<BaseLayout
  title="The Product | Inside PumpOS fuel station management"
  description="Explore shifts, nozzle meter readings, attendant drawers, tank dips, fleet credit and the Daily Station Sales Report (DSSR)."
  path="/product"
>
  <!-- Product Index Hero -->
  <Section class="product-index-hero">
    <SectionHeading
      eyebrow="Inside PumpOS"
      title="From the forecourt to the financial record."
      lead="Your station runs on nozzle readings, attendant handovers, underground dips, fleet credit and daily reconciliations. Explore the four core systems below."
      level="h1"
    >
      <div class="feature-hero-actions">
        <Button variant="primary" href={DEMO_PATH}>Book a guided demo</Button>
        <Button variant="wa" href={WA_URL} target="_blank" rel="noopener">WhatsApp {WHATSAPP_DISPLAY}</Button>
        <Button variant="secondary" href="/pricing">View plan pricing</Button>
      </div>
    </SectionHeading>

    <!-- 4 Feature Cards Grid -->
    <div class="product-features-grid">
      {featureList.map((f) => (
        <Card as="a" href={f.href} class="product-feature-card">
          <div>
            <div class="product-feature-card-top">
              <span class="ds-ey" style="margin: 0;">{f.eyebrow}</span>
              <div class="product-feature-icon" aria-hidden="true">
                <Fragment set:html={f.icon} />
              </div>
            </div>
            <h2>{f.title}</h2>
            <p>{f.description}</p>
            <ul style="list-style: none; padding: 0; margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px; color: var(--ds-ink);">
              {f.bullets.map((b) => (
                <li style="display: flex; align-items: center; gap: 6px;">
                  <span style="color: var(--ds-primary); font-weight: 800;">✓</span> {b}
                </li>
              ))}
            </ul>
          </div>
          <div class="card-link">
            Explore {f.title} <Fragment set:html={icons.arrow} />
          </div>
        </Card>
      ))}
    </div>

    <!-- Practical Day Closing Guide Feature Callout -->
    <div class="product-guide-banner">
      <div>
        <p class="ds-ey" style="margin: 0 0 6px 0;">Practical Forecourt Guide</p>
        <h3>Day closing and DSR for any OMC dealership</h3>
        <p>A practical guide to end-of-day reconciliation for Indian fuel stations: readings → drawers → dips → credit → day close. Built for dealers under IOCL, BPCL, HPCL, Nayara, Jio-bp, or Shell.</p>
      </div>
      <div>
        <Button variant="secondary" href="/blog/day-closing-and-dsr-guide">
          Read the practical guide <Fragment set:html={icons.arrow} />
        </Button>
      </div>
    </div>
  </Section>

  <!-- Station Workspaces Section -->
  <Section tone="alt" class="product-workspaces">
    <SectionHeading
      eyebrow="Station Workspaces"
      title="Built for the roles at your station"
      lead="Dedicated interfaces for managers at the desk, attendants at the dispenser, and owners on the move."
    />
    <div class="product-workspaces-grid">
      <Card class="product-workspace-card">
        <div class="product-feature-icon" aria-hidden="true">
          <Fragment set:html={icons.desktop} />
        </div>
        <h3>Manager Desktop App</h3>
        <p>The primary station operating console. Managers open shifts, carry forward meter readings, log tanker purchases, record dips, and close the Business Day.</p>
        <div style="margin-top: 16px;">
          <a href="/download" class="card-link" style="margin: 0; font-size: 13px;">Download desktop app <Fragment set:html={icons.arrow} /></a>
        </div>
      </Card>

      <Card class="product-workspace-card">
        <div class="product-feature-icon" aria-hidden="true">
          <Fragment set:html={icons.phone} />
        </div>
        <h3>Owner Mobile View</h3>
        <p>Review customer dues, recent bank collections, and closed DSSR snapshots directly from your phone's browser when away from the forecourt.</p>
        <div style="margin-top: 16px;">
          <a href={DEMO_PATH} class="card-link" style="margin: 0; font-size: 13px;">Schedule walkthrough <Fragment set:html={icons.arrow} /></a>
        </div>
      </Card>

      <Card class="product-workspace-card">
        <div class="product-feature-icon" aria-hidden="true">
          <Fragment set:html={icons.shield} />
        </div>
        <h3>Attendant Self-Handover</h3>
        <p>On the Pro plan, attendants submit their cash, card, and UPI declarations directly from their phone browser at shift change. Zero app store downloads.</p>
        <div style="margin-top: 16px;">
          <a href="/pricing" class="card-link" style="margin: 0; font-size: 13px;">Compare plan features <Fragment set:html={icons.arrow} /></a>
        </div>
      </Card>
    </div>
  </Section>

  <!-- CTA Banner -->
  <FeatureCta />
</BaseLayout>
