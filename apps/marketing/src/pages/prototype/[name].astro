    });
    document.querySelectorAll('[data-rival]').forEach((r) => r.querySelectorAll('[data-rv]').forEach((b) => b.addEventListener('click', () => {
      r.dataset.rival = b.dataset.rv; r.querySelectorAll('[data-rv]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    })));
  </script>
  <script>
    // Tab sections — four behaviours to compare
    const TMODES = [['list', 'Progress list'], ['auto', 'Auto-play'], ['scrub', 'Scroll-scrub'], ['story', 'Sticky story'], ['swipe', 'Swipe row']];
    let tmode = new URLSearchParams(location.search).get('tabs');
    if (!TMODES.some(([k]) => k === tmode)) tmode = 'list';
    const sys = [...document.querySelectorAll('[data-scrolly]')];
    const state = new Map(sys.map((sec) => [sec, { i: 0, t0: performance.now(), hover: false, inView: false }]));
    const setTab = (sec, i, p = 0, fromRow = false) => {
      state.get(sec).i = i;
      sec.querySelectorAll('[data-tab]').forEach((b) => { const on = +b.dataset.tab === i; if ((b.getAttribute('aria-selected') === 'true') !== on) b.setAttribute('aria-selected', String(on)); if (on) b.style.setProperty('--p', p); });
      if (tmode === 'swipe') { if (!fromRow) { const row = sec.querySelector('.tabpanels'), el = row.querySelector(`[data-panel="${i}"]`); row.scrollTo({ left: el.offsetLeft - row.offsetLeft, behavior: 'smooth' }); } return; }
      sec.querySelectorAll('[data-panel]').forEach((x) => { const on = +x.dataset.panel === i; if (x.hidden === on) x.hidden = !on; });
    };
    const applyMode = () => {
      document.body.dataset.t = tmode;
      document.querySelector('[data-tlabel]').textContent = TMODES.find(([k]) => k === tmode)[1];
      sys.forEach((sec) => { sec.querySelectorAll('[data-panel]').forEach((x) => (x.hidden = tmode !== 'swipe' && +x.dataset.panel !== 0)); setTab(sec, 0); state.get(sec).t0 = performance.now(); });
      const u = new URL(location.href); u.searchParams.set('tabs', tmode); history.replaceState(null, '', u);
      onScroll(); if (typeof sizePanels === 'function') requestAnimationFrame(sizePanels);
    };
    // auto: advance every 5s while visible, pause on hover/focus
    const io = new IntersectionObserver((es) => es.forEach((e) => { const st = state.get(e.target); st.inView = e.isIntersecting; st.t0 = performance.now(); }), { threshold: 0.35 });
    sys.forEach((sec) => { io.observe(sec); const st = state.get(sec); sec.addEventListener('pointerenter', () => (st.hover = true)); sec.addEventListener('pointerleave', () => { st.hover = false; st.t0 = performance.now() - (+(sec.querySelector('[aria-selected="true"]')?.style.getPropertyValue('--p')) || 0) * 5000; }); });
    const tick = (now) => {
      if (tmode === 'auto' || tmode === 'list') sys.forEach((sec) => {
        const st = state.get(sec), n = sec.querySelectorAll('[data-tab]').length;
        if (!st.inView || st.hover) { st.t0 = now - (+(sec.querySelector('[aria-selected="true"]')?.style.getPropertyValue('--p')) || 0) * 5000; return; }
        const p = (now - st.t0) / 5000;
        if (p >= 1) { st.t0 = now; setTab(sec, (st.i + 1) % n, 0); } else setTab(sec, st.i, p);
      });
      requestAnimationFrame(tick);
    };
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(tick);
    // scrub: no pinning; the tab follows the section's position as it crosses the viewport
    // story: the step nearest the viewport centre is active
    function onScroll() {
      if (tmode === 'scrub') sys.forEach((sec) => {
        const n = sec.querySelectorAll('[data-tab]').length, r = sec.getBoundingClientRect();
        const prog = Math.min(Math.max((innerHeight * 0.9 - r.top) / (r.height + innerHeight * 0.4), 0), 0.9999) * n;
        setTab(sec, Math.floor(prog), prog % 1);
      });
      if (tmode === 'story') sys.forEach((sec) => {
        let best = 0, d = 1e9;
        sec.querySelectorAll('[data-tab]').forEach((b) => { const r = b.getBoundingClientRect(), dd = Math.abs(r.top + r.height / 2 - innerHeight * 0.55); if (dd < d) { d = dd; best = +b.dataset.tab; } });
        if (best !== state.get(sec).i) setTab(sec, best);
      });
    }
    const sizePanels = () => sys.forEach((sec) => {
      const wrap = sec.querySelector('.tabpanels'), ps = [...wrap.querySelectorAll(':scope > [data-panel]')];
      wrap.style.minHeight = '';
      if (tmode === 'swipe') return;
      const was = ps.map((p) => p.hidden); ps.forEach((p) => (p.hidden = false));
      const h = Math.max(...ps.map((p) => p.offsetHeight)); ps.forEach((p, k) => (p.hidden = was[k]));
      const nav = wrap.querySelector('.sy-nav'); wrap.style.minHeight = h + (nav && nav.offsetHeight ? nav.offsetHeight + 14 : 0) + 'px';
    });
    addEventListener('resize', sizePanels);
    addEventListener('scroll', onScroll, { passive: true });
    sys.forEach((sec) => {
      const nav = document.createElement('div'); nav.className = 'sy-nav';
      nav.innerHTML = '<button type="button" aria-label="Previous">‹</button><button type="button" aria-label="Next">›</button>';
      sec.querySelector('.tabpanels').append(nav);
      nav.querySelectorAll('button').forEach((b, k) => b.addEventListener('click', () => { const n = sec.querySelectorAll('[data-tab]').length, st = state.get(sec); st.t0 = performance.now(); setTab(sec, (st.i + (k ? 1 : -1) + n) % n, 0); }));
      sec.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => {
        const i = +b.dataset.tab;
        if (tmode === 'story') { const r = b.getBoundingClientRect(); scrollTo({ top: scrollY + r.top + r.height / 2 - innerHeight * 0.55, behavior: 'smooth' }); return; }
        state.get(sec).t0 = performance.now(); setTab(sec, i, 0);
      }));
      const row = sec.querySelector('.tabpanels');
      row.addEventListener('scroll', () => { if (tmode !== 'swipe') return; const items = [...row.children]; let best = 0, d = 1e9; items.forEach((x, k) => { const dd = Math.abs(x.offsetLeft - row.offsetLeft - row.scrollLeft); if (dd < d) { d = dd; best = k; } }); if (best !== state.get(sec).i) setTab(sec, best, 0, true); }, { passive: true });
    });
    document.querySelectorAll('[data-tstep]').forEach((b) => b.addEventListener('click', () => { const k = TMODES.findIndex(([x]) => x === tmode); tmode = TMODES[(k + +b.dataset.tstep + TMODES.length) % TMODES.length][0]; applyMode(); }));
    applyMode();
    // Leaks: cards sit below the sticky heading and share one height
    const fit = () => {
      const how = document.getElementById('how'), head = how.querySelector('.lk-head'), cards = [...how.querySelectorAll('.deck .leak')];
      const top = parseFloat(getComputedStyle(head).top) || 0;
      how.style.setProperty('--hh', top + head.offsetHeight + 'px');
      cards.forEach((c) => (c.style.minHeight = ''));
      const h = Math.max(...cards.map((c) => c.offsetHeight));
      cards.forEach((c) => (c.style.minHeight = h + 'px'));
      // Heading and cards must leave together: end the heading's container where the last card unpins.
      const lastLi = how.querySelector('.deck > li:last-child'), lift = (parseFloat(getComputedStyle(lastLi).top) || 0) - (top + head.offsetHeight) + h;
      how.querySelector('.deck').parentElement.style.marginBottom = -lift + 'px';
      how.querySelector('.lk-spacer').style.height = lift + 'px';
    };
    addEventListener('resize', fit); fit();
  </script>
  <script>
    // FAQ B: topic chips
    document.querySelectorAll('[data-fgrp]').forEach((g) => g.querySelectorAll('[data-cat]').forEach((b) => b.addEventListener('click', () => {
      g.querySelectorAll('[data-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      g.querySelectorAll('[data-col-cat]').forEach((c) => (c.hidden = b.dataset.cat !== 'all' && c.dataset.colCat !== b.dataset.cat));
      g.toggleAttribute('data-one', b.dataset.cat !== 'all');
    })));
    // FAQ C: search, open the first match, unanswered goes to WhatsApp prefilled
    document.querySelectorAll('[data-fsearch]').forEach((f) => {
      const input = f.querySelector('input'), items = [...f.querySelectorAll('details')], none = f.querySelector('.fq-none');
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase(); let first = null;
        items.forEach((d) => { const hit = !q || q.split(/\s+/).every((w) => d.dataset.text.includes(w)); d.hidden = !hit; if (hit && !first) first = d; });
        if (q && first) first.open = true;
        none.hidden = !!first || !q;
        f.querySelector('[data-echo]').textContent = input.value.trim();
        f.querySelector('[data-ask]').href = 'https://wa.me/919061904860?text=' + encodeURIComponent('Question about PumpOS: ' + input.value.trim());
      });
    });
    // FAQ D: master–detail
    document.querySelectorAll('[data-fmd]').forEach((m) => m.querySelectorAll('[data-fq]').forEach((b) => b.addEventListener('click', () => {
      m.querySelectorAll('[data-fq]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      m.querySelectorAll('[data-fa]').forEach((a) => (a.hidden = a.dataset.fa !== b.dataset.fq));
    })));
  </script>
  <script define:vars={{ variants }}>
    const keys = variants.map((v) => v.key), label = document.querySelector('[data-label]');
    let cur = new URLSearchParams(location.search).get('variant');
    if (!keys.includes(cur)) cur = 'A';
    const show = () => { document.body.dataset.v = cur; label.textContent = `${cur} · ${variants.find((v) => v.key === cur).name}`; const u = new URL(location.href); u.searchParams.set('variant', cur); history.replaceState(null, '', u); };
    const step = (d) => { cur = keys[(keys.indexOf(cur) + d + keys.length) % keys.length]; show(); };
    document.querySelectorAll('[data-step]').forEach((b) => b.addEventListener('click', () => step(+b.dataset.step)));
    addEventListener('keydown', (e) => { if (e.target.closest('input,textarea,[contenteditable]')) return; if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
    show();
  </script>
</body>
</html>
