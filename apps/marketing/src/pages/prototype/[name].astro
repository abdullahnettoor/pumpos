---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" />
  <title>PROTOTYPE · PumpOS landing</title>
  <style is:global>
    @font-face { font-family: 'Plus Jakarta Sans'; src: url('/fonts/brand/plus-jakarta-sans-variable.woff2') format('woff2'); font-weight: 200 800; }
    :root { --primary:#1F6A53; --deep:#0F2A21; --ink:#18201A; --canvas:#F6F7F4; --border:#D9DED6; --muted:#5E6A61; --amber:#B7811E; --danger:#B44A3F; --danger-soft:#F7E7E4; --amber-soft:#F6EEDB; --primary-soft:#E5F0EB; --alt:#EEF0EC; --wa:#1F9D55; }
    * { box-sizing: border-box; margin: 0; }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--canvas); color: var(--ink); -webkit-font-smoothing: antialiased; font-size: 15px; }
    a { color: inherit; text-decoration: none; }
    .w { max-width: 1248px; margin: auto; padding-inline: 32px; }
    .ey { font-size: 13px; letter-spacing: .1em; font-weight: 700; color: var(--primary); text-transform: uppercase; }
    .h2 { font-size: clamp(34px, 4vw, 52px); line-height: 1.08; letter-spacing: -.035em; font-weight: 800; }
    .mut { color: var(--muted); }
    .btn { height: 52px; display: inline-flex; align-items: center; gap: 10px; padding-inline: 24px; border-radius: 10px; font-weight: 700; font-size: 16px; border: 1px solid var(--border); background: #fff; }
    .btn.p { background: var(--primary); color: #fff; border-color: var(--primary); }
    .card { background: #fff; border: 1px solid var(--border); border-radius: 20px; }
    .tbc { outline: 2px dashed var(--amber); outline-offset: 3px; border-radius: 4px; }
    .tbc::after { content: ' TBC'; font-size: 9px; font-weight: 800; color: var(--amber); vertical-align: super; }
    section { padding-block: 112px; }
    svg.i { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke-width: 2.3; stroke-linecap: round; stroke-linejoin: round; }

    /* nav */
    .nav { display: flex; align-items: center; justify-content: space-between; padding-block: 22px; border-bottom: 1px solid var(--border); }
    .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 19px; letter-spacing: -.02em; }
    .logo i { width: 30px; height: 30px; border-radius: 8px; background: var(--primary); display: grid; place-items: center; }
    .links { display: flex; gap: 36px; font-weight: 500; color: var(--muted); }
    .acts { display: flex; gap: 8px; align-items: center; font-weight: 600; }
    .acts .dk { height: 40px; display: flex; align-items: center; padding-inline: 18px; border-radius: 8px; background: var(--ink); color: #fff; }
    .acts .wa { height: 40px; display: flex; align-items: center; gap: 8px; padding-inline: 14px; border-radius: 8px; background: #fff; border: 1px solid var(--border); font-weight: 700; font-size: 14px; }
    body .navwrap { background: var(--deep); color: #fff; }
    body .nav { border-color: #ffffff22; } body .links { color: #b9cdc4; } body .acts .dk { background: #fff; color: var(--ink); }

    /* hero */
    .hero { display: flex; gap: 64px; align-items: center; padding-block: 96px 72px; }
    .hero h1 { font-size: clamp(44px, 5.4vw, 76px); line-height: 1; letter-spacing: -.045em; font-weight: 800; }
    .hero .lede { font-size: 20px; line-height: 1.5; max-width: 520px; color: var(--muted); }
    .hero-copy { flex: 1; display: flex; flex-direction: column; gap: 28px; }
    .ticks { display: flex; gap: 24px; flex-wrap: wrap; font-size: 14px; font-weight: 600; color: var(--muted); }
    .ticks span { display: flex; gap: 8px; align-items: center; }
    .dsr { width: 560px; flex-shrink: 0; overflow: hidden; box-shadow: 0 30px 60px -30px #0F2A2140; }
    .dsr-h { display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; border-bottom: 1px solid var(--border); }
    .pill { font-size: 11px; font-weight: 700; padding: 5px 12px; border-radius: 99px; border: 1px solid var(--border); color: var(--muted); }
    .dsr-rows { padding: 8px 24px; }
    .dsr-rows div { display: flex; justify-content: space-between; padding-block: 14px; border-bottom: 1px solid var(--alt); }
    .dsr-rows div:last-child { border: 0; font-weight: 800; }
    .dsr-rows b { font-variant-numeric: tabular-nums; }
    .short { display: flex; align-items: center; gap: 14px; margin: 0 16px 16px; padding: 16px; border-radius: 12px; background: var(--danger-soft); }
    .short .av { width: 36px; height: 36px; border-radius: 99px; background: #fff; display: grid; place-items: center; font-weight: 800; font-size: 13px; color: var(--danger); }
    .short strong { font-size: 22px; color: var(--danger); margin-left: auto; letter-spacing: -.02em; }
    body .hero-wrap { background: var(--deep); color: #fff; }
    body .hero { flex-direction: column; text-align: center; padding-bottom: 0; gap: 56px; }
    body .hero-copy { align-items: center; }
    body .hero .lede, body .ticks { color: #b9cdc4; } body .hero .ey { color: #8fd1b4; }
    body .hero h1 { max-width: 16ch; font-size: clamp(48px, 6.4vw, 92px); }
    body .hero .dsr { width: min(760px, 100%); color: var(--ink); margin-bottom: -120px; }
    body .brands { padding-top: 160px; }
    .brands { display: flex; justify-content: space-between; align-items: center; padding-block: 28px; border-block: 1px solid var(--border); font-size: 14px; font-weight: 600; color: var(--muted); }
    .brands div { display: flex; gap: 48px; font-size: 18px; font-weight: 800; color: #8B968D; }

    /* leaks */
    .lk-head { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 56px; }
    .lk-head .h2 { max-width: 700px; margin-top: 14px; }
    .lk-head p { max-width: 380px; font-size: 17px; line-height: 1.55; }
    .leak { padding: 28px; display: flex; flex-direction: column; gap: 20px; }
    .leak .k { font-size: 12px; letter-spacing: .08em; font-weight: 700; color: var(--muted); }
    .leak h3 { font-size: 24px; line-height: 1.25; letter-spacing: -.02em; font-weight: 800; }
    .chip { display: flex; justify-content: space-between; align-items: center; padding: 16px; border-radius: 12px; }
    .chip.danger { background: var(--danger-soft); } .chip.danger strong { color: var(--danger); }
    .chip.amber { background: var(--amber-soft); } .chip.amber strong { color: #8f6414; }
    .chip strong { font-size: 26px; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .chip small { display: block; font-size: 12px; color: var(--muted); }
    .leak p { color: var(--muted); line-height: 1.55; }
    .grid3 { display: flex; gap: 20px; }
    .grid3 > * { flex: 1; }
    .final { background: var(--deep); color: #fff; border-color: var(--deep); }
    .final .k, .final p { color: #b9cdc4; } .final h3 { color: #fff; }
    .res { list-style: none; padding: 0; border-top: 1px solid #ffffff22; }
    .res li { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 12px; border-bottom: 1px solid #ffffff22; font-size: 14px; }
    .res span { color: #b9cdc4; font-size: 13px; display: block; }
    .res em { font-style: normal; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 99px; background: var(--primary); }
    .res em.v { background: var(--amber); }
    /* B: sticky stacked deck */
    .deck { display: flex; flex-direction: column; gap: 32px; padding-bottom: 18vh; list-style: none; padding-left: 0; }
    .deck > li { position: sticky; top: calc(40px + var(--i) * 22px); z-index: calc(var(--i) + 1); }
    .deck .leak { display: grid; grid-template-columns: 1.3fr 1fr; gap: 20px 48px; align-items: center; min-height: 360px; padding: 44px; box-shadow: 0 -12px 30px -24px rgba(24,32,26,.4); }
    .deck .leak h3 { font-size: clamp(28px, 3vw, 40px); line-height: 1.08; }
    .deck .chip { grid-column: 2; grid-row: 1 / span 3; flex-direction: column; align-items: flex-start; gap: 10px; padding: 28px; }
    .deck .chip strong { font-size: clamp(44px, 5vw, 68px); line-height: 1; }
    .deck .final .res { grid-column: 2; grid-row: 1 / span 3; }
    /* C: pinned headline + stacking column */
    .split { display: grid; grid-template-columns: 1fr 1.5fr; gap: 64px; align-items: start; }
    .split .side { position: sticky; top: 64px; display: flex; flex-direction: column; gap: 18px; }
    .split .side p { font-size: 17px; line-height: 1.55; max-width: 34ch; }
    .split .col { display: flex; flex-direction: column; gap: 28vh; list-style: none; padding: 0 0 12vh; }
    .split .col > li { position: sticky; top: calc(64px + var(--i) * 16px); z-index: calc(var(--i) + 1); }
    .split .leak { box-shadow: 0 -12px 30px -24px rgba(24,32,26,.4); }

    /* credit closer look */
    .cl { display: grid; grid-template-columns: 1fr 1.25fr; gap: 64px; align-items: start; margin-top: 56px; }
    .steps { display: flex; flex-direction: column; }
    .steps div { display: grid; grid-template-columns: 44px 1fr; gap: 4px 12px; padding-block: 20px; border-top: 1px solid var(--border); }
    .steps div:first-child { border-color: var(--primary); }
    .steps b { grid-row: span 3; font-size: 13px; color: var(--muted); } .steps div:first-child b { color: var(--primary); }
    .steps small { font-size: 11px; letter-spacing: .08em; font-weight: 700; color: var(--muted); }
    .steps h4 { font-size: 19px; letter-spacing: -.015em; }
    .steps p { color: var(--muted); line-height: 1.5; font-size: 14px; }
    .stmt { overflow: hidden; }
    .st-h { display: flex; justify-content: space-between; align-items: end; padding: 24px; border-bottom: 1px solid var(--border); }
    .st-h strong { font-size: 30px; letter-spacing: -.03em; display: block; }
    .tr { display: grid; grid-template-columns: 90px 1fr 110px 110px; padding: 14px 24px; border-bottom: 1px solid var(--alt); font-size: 14px; font-variant-numeric: tabular-nums; }
    .tr > :nth-child(n+3) { text-align: right; }
    .tr.th { font-size: 12px; font-weight: 600; color: var(--muted); padding-block: 10px; }
    .tr.last { background: var(--primary-soft); font-weight: 700; }
    .st-f { display: flex; justify-content: space-between; padding: 16px 24px; font-size: 13px; color: var(--muted); }
    .st-f a { color: var(--primary); font-weight: 700; }

    /* screens */
    .screens { display: grid; grid-template-columns: 1.6fr 1fr; gap: 20px; margin-top: 48px; }
    .scr { padding: 28px; display: flex; flex-direction: column; gap: 10px; }
    .scr h3 { font-size: 22px; letter-spacing: -.02em; }
    .kt { margin-top: 14px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .kt div { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; padding: 12px 16px; border-bottom: 1px solid var(--alt); font-size: 14px; }
    .kt div:first-child { background: var(--canvas); font-size: 12px; color: var(--muted); font-weight: 600; }
    .st { font-size: 12px; font-weight: 700; padding: 3px 9px; border-radius: 99px; justify-self: start; background: var(--primary-soft); color: var(--primary); }
    .st.near { background: var(--amber-soft); color: #8f6414; } .st.over { background: var(--danger-soft); color: var(--danger); }
    .phone { margin: 14px auto 0; width: 260px; border: 8px solid var(--ink); border-radius: 34px; padding: 22px 18px; display: flex; flex-direction: column; gap: 12px; }
    .phone .r { display: flex; justify-content: space-between; padding: 12px; border: 1px solid var(--border); border-radius: 10px; font-size: 14px; }
    .phone .go { background: var(--primary); color: #fff; text-align: center; padding: 13px; border-radius: 10px; font-weight: 700; }

    /* roles */
    .dark { background: var(--deep); color: #fff; }
    .dark .mut, .dark p { color: #b9cdc4; }
    .roles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #ffffff22; border: 1px solid #ffffff22; border-radius: 20px; overflow: hidden; margin-top: 48px; }
    .roles div { background: var(--deep); padding: 28px; display: flex; flex-direction: column; gap: 10px; }
    .roles small { font-size: 12px; letter-spacing: .1em; font-weight: 700; color: #8fd1b4; }
    .roles h4 { font-size: 20px; letter-spacing: -.02em; }

    /* features */
    .fh { display: flex; justify-content: space-between; align-items: end; }
    .fh a { font-weight: 700; color: var(--primary); }
    .feat { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; margin-top: 48px; }
    .feat div { background: #fff; padding: 28px; display: flex; flex-direction: column; gap: 8px; }
    .feat h4 { font-size: 18px; }
    .feat p { color: var(--muted); line-height: 1.5; font-size: 14px; }
    .soon { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 20px; font-size: 14px; color: var(--muted); }
    .soon span { padding: 6px 12px; border: 1px dashed var(--border); border-radius: 99px; background: #fff; }
    .soon b { color: var(--ink); }

    /* why + compare */
    .why { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; }
    .why ol { list-style: none; padding: 0; }
    .why li { display: grid; grid-template-columns: 48px 1fr; gap: 6px; padding-block: 24px; border-top: 1px solid var(--border); }
    .why li b { color: var(--primary); grid-row: span 2; }
    .why h4 { font-size: 20px; letter-spacing: -.02em; } .why p { color: var(--muted); line-height: 1.55; }
    .cmp { margin-top: 48px; overflow: hidden; }
    .cr { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1.25fr; }
    .cr > div { padding: 18px 22px; border-bottom: 1px solid var(--alt); font-size: 14px; line-height: 1.45; }
    .cr > div:first-child { font-weight: 700; }
    .cr > div:nth-child(2), .cr > div:nth-child(3) { color: var(--muted); }
    .cr > div:last-child { background: var(--primary-soft); font-weight: 600; color: var(--deep); }
    .cr.th > div { font-size: 12px; font-weight: 700; color: var(--muted); letter-spacing: .04em; }
    .cr.th > div:last-child { background: var(--primary); color: #fff; }
    .fix { box-shadow: inset 3px 0 0 var(--amber); }

    /* pricing */
    .price { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 24px; }
    .price .card { padding: 32px; display: flex; flex-direction: column; gap: 14px; }
    .price .big { font-size: 48px; font-weight: 800; letter-spacing: -.04em; line-height: 1; }
    .price p { color: var(--muted); line-height: 1.55; }
    .price .hl { border: 2px solid var(--primary); position: relative; }
    .price .hl::before { content: 'Most stations'; position: absolute; top: -12px; left: 32px; background: var(--primary); color: #fff; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 99px; }
    .price .btn { justify-content: center; }

    /* faq */
    .faq { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; }
    details { border-top: 1px solid var(--border); padding-block: 22px; }
    summary { font-weight: 700; font-size: 17px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; }
    details p { margin-top: 12px; color: var(--muted); line-height: 1.6; max-width: 60ch; }

    /* cta + footer */
    .cta { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: center; border-radius: 28px; padding: 64px; background: var(--deep); color: #fff; }
    .cta .h2 { margin-block: 14px 18px; } .cta .ey { color: #8fd1b4; }
    .cta ul { list-style: none; padding: 28px; border: 1px solid #ffffff22; border-radius: 16px; display: flex; flex-direction: column; gap: 14px; }
    .cta li { display: flex; gap: 10px; color: #dce8e2; }
    .foot { display: flex; justify-content: space-between; padding-block: 40px; color: var(--muted); font-size: 14px; border-top: 1px solid var(--border); }
    .foot div { display: flex; gap: 24px; }

    /* prototype bar */
    .pbar { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 99; display: flex; align-items: center; gap: 10px; padding: 6px; border-radius: 99px; background: #111; color: #fff; font: 600 13px/1 system-ui; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
    .pbar button { width: 32px; height: 32px; border-radius: 99px; border: 0; background: #333; color: #fff; cursor: pointer; }
    .pbar span { min-width: 160px; text-align: center; }
    .pbar .pdiv { width: 1px; height: 20px; background: #444; }

    .ghost { border-color: transparent; background: transparent; color: var(--primary); padding-inline: 8px; }
    body .ghost { color: #8fd1b4; }
    .brands p { font-size: 15px; color: var(--muted); font-weight: 500; max-width: 70ch; } .brands p b { color: var(--ink); }
    .brands > span { color: var(--ink); font-weight: 800; }
    .bd { display: flex; flex-direction: column; font-size: 13px; border-top: 1px solid var(--alt); }
    .bd div { display: flex; justify-content: space-between; padding-block: 7px; border-bottom: 1px dashed var(--alt); }
    .bd dt { color: var(--muted); } .bd dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
    .bd div:nth-last-child(2) { font-weight: 700; } .bd div:nth-last-child(2) dt { color: var(--ink); }
    .chip .bd { width: 100%; margin-top: 8px; border-color: #0000001a; } .chip .bd div { border-color: #00000012; }
    .lf { font-size: 12px; font-weight: 700; color: var(--muted); }
    .feat a { background: #fff; padding: 28px; display: flex; flex-direction: column; gap: 8px; }
    .feat a:hover { background: var(--canvas); }
    .feat ul { padding-left: 18px; color: var(--ink); font-size: 13px; line-height: 1.8; flex: 1; }
    .feat .more { color: var(--primary); font-weight: 700; font-size: 13px; }
    .proof { display: grid; grid-template-columns: 220px 1fr; gap: 40px; padding: 40px; align-items: center; }
    .ph { aspect-ratio: 1; border-radius: 16px; background: var(--alt); display: grid; place-items: center; color: var(--muted); font-weight: 700; }
    blockquote { font-size: clamp(22px, 2.4vw, 30px); line-height: 1.3; letter-spacing: -.02em; font-weight: 700; margin-block: 14px 18px; }
    .pilot { display: flex; align-items: center; gap: 24px; margin-top: 40px; padding: 20px 24px; border-radius: 16px; background: var(--primary-soft); border: 1px solid #1f6a5333; }
    .pilot span { flex: 1; color: var(--deep); }
    .pl { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 14px; flex: 1; }
    .pl li::before { content: '✓  '; color: var(--primary); font-weight: 800; }
    .price .big sup { font-size: 22px; color: var(--muted); }
    .price .hl::before { content: 'Most stations'; }
    .legal { display: flex; flex-direction: column; gap: 6px; }
    .foot { align-items: flex-start; }
    @media (max-width: 900px) {
      .tr { grid-template-columns: 52px 1fr 76px 76px; padding-inline: 14px; font-size: 12px; gap: 6px; }
      .st-h { padding: 16px 14px; gap: 12px; } .st-h strong { font-size: 22px; }
      .proof { grid-template-columns: 1fr; padding: 24px; } .ph { width: 120px; }
      .pilot { flex-direction: column; align-items: stretch; }
      .foot { flex-direction: column; gap: 20px; } .foot div:last-child { flex-wrap: wrap; }
      .links, .acts .dk, .acts > a:first-child { display: none; }
      .hero, .lk-head, .fh { flex-direction: column; align-items: stretch; }
      .dsr { width: 100%; }
      .grid3, .cl, .screens, .why, .faq, .cta, .price, .split { display: flex; flex-direction: column; }
      .roles, .feat { grid-template-columns: 1fr; }
      .brands { flex-direction: column; gap: 16px; } .brands div { flex-wrap: wrap; gap: 20px; }
      .deck > li, .split .side, .split .col > li { position: static; }
      .deck, .split .col { gap: 16px; padding-bottom: 0; }
      .deck .leak { display: flex; min-height: 0; padding: 28px; }
      .cmp { overflow-x: auto; } .cr { min-width: 760px; }
      .cta { padding: 32px; } section { padding-block: 72px; }
    }
  </style>
</head>
