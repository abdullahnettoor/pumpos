{
  "name": "apps-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build --workspace=@pump/ui && VITE_API_URL=https://api.pumpos.app vite build && wrangler deploy",
    "deploy:dev": "npm run build --workspace=@pump/ui && VITE_API_URL=https://api.pumpos.abdullahnettoor.com vite build && wrangler deploy --env preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@pump/shared": "*",
    "@pump/ui": "*",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  }
}
