{
  "name": "pumpos-monorepo",
  "private": true,
  "version": "1.3.1",
  "description": "PumpOS Platform",
  "workspaces": [
    "apps/api",
    "apps/console",
    "apps/desktop",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:console": "npm run dev --workspace=apps/console",
    "dev:marketing": "npm run dev --prefix apps/marketing",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:api:local": "npm run dev:local --workspace=apps/api",
    "dev:api:remote": "npm run dev:remote --workspace=apps/api",
    "deploy:api": "npm run deploy --workspace=apps/api",
    "deploy:console": "npm run deploy --workspace=apps/console",
    "deploy:marketing": "npm run deploy --workspace=apps/marketing",
    "deploy:mobile": "npm run deploy --workspace=apps/mobile",
    "build": "tsc -b && npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=apps/api",
    "build:ui-console": "npm run build --workspace=packages/ui && npm run build --workspace=apps/console",
    "build:marketing": "npm run build --prefix apps/marketing",
    "build:ui-mobile": "npm run build --workspace=packages/ui && npm run build --workspace=apps/mobile",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "test": "npm run test --workspaces --if-present",
    "fonts": "node scripts/download-fonts.mjs",
    "release": "node scripts/release.mjs",
    "lint": "node scripts/check-no-hook-disables.mjs && node scripts/check-icon-button-labels.mjs && eslint . --pass-on-unpruned-suppressions",
    "lint:no-hook-disables": "node scripts/check-no-hook-disables.mjs",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "lint:warnings": "eslint . --suppressions-location .eslint-empty-suppressions.json",
    "lint:baseline": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "zod": "^3.25.76"
  }
}
