{
  "name": "@pump/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "drizzle-kit generate && node scripts/sync-supabase-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node seed.mjs",
    "db:generate:custom": "node scripts/generate-custom.mjs",
    "db:sync-supabase": "node scripts/sync-supabase-migrations.mjs",
    "db:check": "node scripts/check-migration-chain.mjs && node scripts/sync-supabase-migrations.mjs --check"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.11.5",
    "typescript": "^5.4.5"
  }
}
